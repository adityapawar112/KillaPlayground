# Set default behavior: auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Platform Script Endings
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Source Code & Text Assets
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.glsl text eol=lf
*.vert text eol=lf
*.frag text eol=lf

# 3D Assets, Textures & Media (Explicit Binary Treatment)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.glb binary
*.gltf text eol=lf
*.ktx2 binary
*.bin binary
*.hdr binary
*.exr binary
*.mp3 binary
*.ogg binary
*.wav binary
*.mp4 binary
*.webm binary
*.pdf binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Agent Skills & Vendored Tooling (Preserve GitHub Repo Language Stats)
.agents/** linguist-vendored
skills-lock.json linguist-generated
